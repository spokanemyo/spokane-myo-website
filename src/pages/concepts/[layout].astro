---
import AgeLayoutConcept from "../../components/AgeLayoutConcept.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const concepts = {
    balanced: {
      title: "Concept 1 — Balanced image-left cards",
      summary:
        "Each nature image forms the left side of its matching text box. This is the closest interpretation of your request.",
    },
    framed: {
      title: "Concept 2 — Framed image insets",
      summary:
        "The images sit inside their matching text boxes like lightly framed photographs, leaving more breathing room around them.",
    },
    alternating: {
      title: "Concept 3 — Alternating editorial cards",
      summary:
        "The cards alternate image placement on desktop for more movement; every image moves above its text on phones.",
    },
  } as const;

  return Object.entries(concepts).map(([layout, concept]) => ({
    params: { layout },
    props: { concept, layout },
  }));
}

type Layout = "balanced" | "framed" | "alternating";

interface Props {
  concept: {
    title: string;
    summary: string;
  };
  layout: Layout;
}

const { concept, layout } = Astro.props;
---

<BaseLayout
  title={`${concept.title} | Spokane Myofunctional Therapy`}
  description="Temporary test-site layout comparison for Spokane Myofunctional Therapy."
  noindex={true}
>
  <section class="concept-intro">
    <p class="concept-kicker">TEST-SITE LAYOUT PREVIEW</p>
    <h1>{concept.title}</h1>
    <p>{concept.summary}</p>
    <nav aria-label="Layout concepts">
      <a class:list={{ active: layout === "balanced" }} href="/concepts/balanced/">Concept 1</a>
      <a class:list={{ active: layout === "framed" }} href="/concepts/framed/">Concept 2</a>
      <a class:list={{ active: layout === "alternating" }} href="/concepts/alternating/">Concept 3</a>
    </nav>
  </section>

  <AgeLayoutConcept variant={layout} />
</BaseLayout>

<style>
  .concept-intro {
    width: min(900px, calc(100% - 2rem));
    margin: 1rem auto 2rem;
    text-align: center;
  }

  .concept-kicker {
    margin-bottom: 0.4rem;
    color: var(--purple);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 400;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  nav a {
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 2px solid var(--purple);
    border-radius: 999px;
    color: var(--purple);
    font-weight: 700;
    text-decoration: none;
  }

  nav a.active,
  nav a:hover {
    background: var(--purple);
    color: var(--paper);
  }
</style>
